layout {

    focus-ring {
        active-color   "#a8c8ff"
        inactive-color "#111318"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a8c8ff"
        inactive-color "#111318"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a8c8ff"
        inactive-color "#264777"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a8c8ff80"
    }
}
