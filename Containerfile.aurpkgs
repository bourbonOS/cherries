# builder image
FROM archlinux:latest AS builder

# install base packages
RUN pacman -Syu --noconfirm --needed base-devel git sudo
RUN useradd -m builder
RUN echo "builder ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/builder

# setup chaotic-aur
RUN pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com && \
    pacman-key --lsign-key 3056513887B78AEB && \
    pacman -U --noconfirm "https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst" && \
    pacman -U --noconfirm "https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst" && \
    printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' >> /etc/pacman.conf && \
    pacman -Sy

# now start working as build user
USER builder
WORKDIR /home/builder

# build yay and prepare package lists
RUN git clone https://aur.archlinux.org/yay-bin.git && \
    cd yay-bin && \
    makepkg -si --noconfirm && \
    cd .. && \
    rm -rf yay-bin
COPY --chown=builder:builder system-packages/ .
RUN mkdir -p /home/builder/mainsys-pkgs /home/builder/subsys-pkgs

# build mainsys aur pkgs
RUN while read -r pkg; do \
    echo "Building $pkg..."; \
    yay -G "$pkg" && \
    cd "$pkg" && \
    makepkg -sr --noconfirm --nocheck && \
    cp *.pkg.tar.zst /home/builder/mainsys-pkgs/ && \
    cd /home/builder && \
    rm -rf "$pkg"; \
    done < mainsys-pkgs.txt

# build subsys aur pkgs
RUN while read -r pkg; do \
    echo "Building $pkg..."; \
    yay -G "$pkg" && \
    cd "$pkg" && \
    makepkg -sr --noconfirm --nocheck && \
    cp *.pkg.tar.zst /home/builder/subsys-pkgs/ && \
    cd /home/builder && \
    rm -rf "$pkg"; \
    done < subsys-pkgs.txt

# dummy install maplemono - we'll copy the built packages later
RUN yay -S --noconfirm maplemono-ttf

# final image
FROM scratch AS final

# copy mainsys packages
COPY --from=builder /home/builder/mainsys-pkgs/ /mainsys/
COPY --from=builder home/builder/.cache/yay/maplemono/maplemono-nf-cn-unhinted-*-any.pkg.tar.zst /mainsys/
COPY --from=builder home/builder/.cache/yay/maplemono/maplemono-cn-unhinted-*-any.pkg.tar.zst /mainsys/
COPY --from=builder home/builder/.cache/yay/maplemono/maplemono-ttf-*-any.pkg.tar.zst /mainsys/

# copy subsys packages
COPY --from=builder /home/builder/subsys-pkgs/ /subsys/
